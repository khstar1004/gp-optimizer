# Copy this file to .env for a local deployment.
# Never commit the populated .env file.
MAPTILER_API_KEY=
VWORLD_API_KEY=
VWORLD_DOMAIN=localhost
ITS_API_KEY=
# ArcGIS Developer API key, "Static basemap tiles" privilege only (free tier:
# https://developers.arcgis.com/documentation/security-and-authentication/api-key-authentication/).
# Used for the default World Imagery basemap; proxied+cached by server.cts (/arcgis-img).
ARCGIS_API_KEY=
# Optional: choose an installed non-embedding Ollama model.
OLLAMA_MODEL=
# Optional: path to blender.exe, used only by scripts/mcp-blender-pipeline.mts
# (npm run mcp:blender). Defaults to
# "C:\Program Files\Blender Foundation\Blender 5.2\blender.exe" if unset.
BLENDER_EXE=
# The server defaults to loopback. Change HOST only behind an authenticated proxy.
HOST=127.0.0.1
PORT=8917
# Optional: set to 1 to force basemap/terrain tiles to serve from disk cache only
# (data/tile-cache/), never hitting the real network. Use when you know there's no
# internet on site and want instant cache-or-fail instead of connection timeouts.
GP_OFFLINE_TILES=
